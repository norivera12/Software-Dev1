    public static int add(int zyx, int tuv){


        return(zyx + tuv);


    }
public static void HW2(Scanner sc){
    System.out.println("Give me a number and I will give you the factorial");
    int num1 = sc.nextInt();
    int factorial = 1;
    for (int i = 1; i <= num1; i++){
        factorial = factorial * i;
    }
    System.out.println("The factorial of " + num1 + " is " + factorial);
}
public static void HW3(Scanner sc){
System.out.println("Give me a number and I will give you the sum of every other number");
int num2 = sc.nextInt();
int sum = 0;
for (int i = 0; i < num2; i += 2)
{sum = sum + i;
    System.out.println("The sum is: " + sum);
}
}
public static void HW5(Scanner sc){
    System.out.println("Give me a word and I'll give it back backwords");
    sc.nextLine();
String word = sc.nextLine();
String backwords = "";
for (int i = word.length() - 1; i >= 0; i--)
{backwords = backwords + word.charAt(i);}
System.out.println(backwords);
}

    public static void printDog(){
        System.out.println("Dog");
    }

}
