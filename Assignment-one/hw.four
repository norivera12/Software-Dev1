import java.util.Scanner;
import java.util.Collections;

/*
Take the given array and keep track of
1. Any duplicate numbers
2. How many times the dublipcate numbers appear
3. Print out those dublicate numbers with how many times they appear

*/
public class HW4 {
public static void main(String[] args){
   
int[] myArray = {10,3, 295, 38, 20, 3, 4, 267, 2445, 10, 5566, 87, 93, 17, 10, 2, 87, 267, 3176, 3, 82};
//you cannot use the array util. Do this one by hand:(



for (int i = 0; i < myArray.length; i++) {
    int count = 1;
    int k;

//next lines check if a number was counted already
    for (k = 0; k < i; k++){
        if (myArray[i] == myArray[k]){
            break;
        } 
    }

//this only checks duplicates IF its the first time they're being counted
    if (k == i) {
        for (int j = i + 1; j <myArray.length; j++)
        if (myArray[i] == myArray[j]){
            count++;}
        }
      
        if (count > 1){
            System.out.println(myArray[i] + " shows up " + count + " times");}


        }
    }
}

//this loop stuff is very hard and I'm still having difficulties getting used to them not going to lie; 
// I get easily confused with them. I'm learning that when you want to count something you must add "count" 
// at the beginning and "count++" everytime you want it to increase. also learned that "______.length" is what allows the program
