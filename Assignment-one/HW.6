public class Student {

String name;
double gpa; 
int id;
String lunch;
public Student(String n, double g, int i) {
    name = n;
    gpa = g;
    id = i;
}


    void StudentInfo(int generatedID){
if (this.gpa >= 3.6 && this.id == generatedID) {
    System.out.println(name + " (" + gpa + ", " + id + ")" + " is an honor student. and has free lunch today!" );
}
else if (this.gpa >= 3.6 && this.id != generatedID) {
    System.out.println(name + " (" + gpa + ", " + id + ")" + " is an honor student but does not have free lunch today.");
}
else if (this.gpa < 3.6 && this.id == generatedID) {
